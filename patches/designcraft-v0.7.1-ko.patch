+/// The interface language for a system locale: a POSIX value (`ko_KR.UTF-8`), a BCP 47 tag
+/// (`ko-KR`, Windows' `LocaleName`) or a bare language (`ko`). `None` for English and for
+/// languages, scripts or regions without an interface (`pt_PT`, Traditional Chinese).
+pub fn language_for_locale(locale: &str) -> Option<&'static str> {
+    // `ll_CC.encoding@modifier`: the encoding and modifier don't matter.
+    let tag = locale.trim().split(['.', '@']).next()?;
+    let mut parts = tag.split(['_', '-']);
+    let language = parts.next()?.to_ascii_lowercase();
+    if !(2..=3).contains(&language.len()) || !language.bytes().all(|b| b.is_ascii_lowercase()) {
+        return None;
+    }
+    let rest: Vec<String> = parts.map(str::to_ascii_lowercase).collect();
+    let has = |s: &str| rest.iter().any(|p| p == s);
+    match language.as_str() {
+        "ko" => Some("ko"),
+        "de" => Some("de"),
+        "fr" => Some("fr"),
+        "es" => Some("es"),
+        "ja" => Some("ja"),
+        "ar" => Some("ar"),
+        "it" => Some("it"),
+        "uk" => Some("uk"),
+        "pt" if has("br") => Some("pt-br"),
+        // The interface is Simplified Chinese: Traditional script or regions stay English.
+        "zh" if !["hant", "tw", "hk", "mo"].into_iter().any(has) => Some("zh"),
+        _ => None,
+    }
+}
+
+/// The interface language of the system locale ("" for English): on Windows the user's
+/// `LocaleName` (Settings › Time & language › Region), else the first set of `LC_ALL`,
+/// `LC_MESSAGES` and `LANG`. The app uses it on a first launch.
+pub fn system_language() -> &'static str {
+    system_locale().as_deref().and_then(language_for_locale).unwrap_or("")
+}
+
+fn system_locale() -> Option<String> {
+    #[cfg(windows)]
+    if let Some(name) = windows_locale_name() {
+        return Some(name);
+    }
+    ["LC_ALL", "LC_MESSAGES", "LANG"].into_iter().find_map(|v| std::env::var(v).ok().filter(|s| !s.trim().is_empty()))
+}
+
+/// The user's `LocaleName` from the registry, read with `reg.exe` (no `unsafe` Win32 call).
+#[cfg(windows)]
+fn windows_locale_name() -> Option<String> {
+    use std::os::windows::process::CommandExt;
+    /// No console window flashes up.
+    const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+    let reg = std::env::var_os("SystemRoot")
+        .map_or_else(|| std::path::PathBuf::from("reg"), |root| std::path::PathBuf::from(root).join("System32").join("reg.exe"));
+    let out = std::process::Command::new(reg)
+        .args(["query", r"HKCU\Control Panel\International", "/v", "LocaleName"])
+        .creation_flags(CREATE_NO_WINDOW)
+        .output()
+        .ok()?;
+    locale_name_from_reg(&String::from_utf8_lossy(&out.stdout))
+}
+
+/// `LocaleName` from `reg query` output (`    LocaleName    REG_SZ    ko-KR`).
+#[cfg(any(windows, test))]
+fn locale_name_from_reg(output: &str) -> Option<String> {
+    output.lines().find_map(|line| match line.split_whitespace().collect::<Vec<_>>().as_slice() {
+        [name, "REG_SZ", value] if name.eq_ignore_ascii_case("LocaleName") => Some((*value).to_owned()),
+        _ => None,
+    })
+}
+

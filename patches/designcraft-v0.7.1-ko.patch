+        let mut seen = std::collections::BTreeSet::new();
+        for text in crate::i18n::korean_catalog() {
+            seen.extend(text.chars().filter(|c| matches!(*c as u32, 0x1100..=0x11FF | 0x3130..=0x318F | 0xA960..=0xA97F | 0xAC00..=0xD7A3)));

+/// The characters of `text` that face `index` of the font file `data` has no glyph for, in
+/// order, each once (all of them when `data` isn't a font). Whitespace and controls are skipped.
+pub fn missing_chars(data: &[u8], index: u32, text: &str) -> Vec<char> {
+    let font = skrifa::FontRef::from_index(data, index).ok();
+    let charmap = font.as_ref().map(|f| f.charmap());
+    let mut missing = Vec::new();
+    for c in text.chars().filter(|c| !c.is_whitespace() && !c.is_control()) {
+        if !charmap.as_ref().is_some_and(|m| m.map(c).is_some()) && !missing.contains(&c) {
+            missing.push(c);
+        }
+    }
+    missing
+}
+

+    fn tofu(defs: &egui::FontDefinitions, family: &FontFamily, text: &str) -> Vec<char> {
+        let mut left: String = text.into();
+        for name in &defs.families[family] {
+            let data = &defs.font_data[name];
+            left = designcraft_fonts::missing_chars(&data.font, data.index, &left).into_iter().collect();
+        }

+/// Installed families tried, in order, for the Korean UI's Hangul when no craft-fonts face has
+/// it: Windows (Malgun Gothic, in every Windows since Vista), macOS, then Linux and Pan-CJK
+/// families (the Noto and Source Han CJK faces have Hangul whatever their region), then older
+/// Windows Korean faces.
+const HANGUL_UI_FAMILIES: &[&str] = &[
+    "Malgun Gothic",
+    "Apple SD Gothic Neo",
+    "Noto Sans CJK KR",
+    "Noto Sans KR",
+    "Source Han Sans K",
+    "Source Han Sans KR",
+    "NanumGothic",
+    "Noto Sans CJK SC",
+    "Noto Sans CJK JP",
+    "Source Han Sans SC",
+    "Gulim",
+    "Dotum",
+];
+
+/// The usual files of the first families, read straight from the system font folders without a
+/// font scan: (file, face index, family).
+#[cfg(not(target_arch = "wasm32"))]
+const HANGUL_UI_FILES: &[(&str, u32, &str)] = &[("malgun.ttf", 0, "Malgun Gothic"), ("AppleSDGothicNeo.ttc", 0, "Apple SD Gothic Neo")];
+
+/// A face counts as Hangul-capable when it has these (first, common and last syllables).
+const HANGUL_PROBE: &str = "가각한글힣";
+
+/// Font-data name of the installed Hangul face in [`font_definitions`].
+const SYSTEM_HANGUL: &str = "system-hangul";
+
+/// An installed face with Hangul for the Korean UI.
+struct SystemFace {
+    family: String,
+    index: u32,
+    data: SystemData,
+}
+
+/// (The web finds no installed face.)
+#[cfg_attr(target_arch = "wasm32", allow(dead_code))]
+enum SystemData {
+    /// Read from one of the usual files.
+    File(Vec<u8>),
+    /// Loaded through the font database.
+    Db(Arc<designcraft_fonts::FontFace>),
+}
+
+impl SystemFace {
+    fn bytes(&self) -> &[u8] {
+        match &self.data {
+            SystemData::File(data) => data,
+            SystemData::Db(face) => face.data(),
+        }
+    }
+}
+
+/// The installed Hangul face for the Korean UI, looked up once (the first time Korean is
+/// selected): the files of [`HANGUL_UI_FILES`], else [`HANGUL_UI_FAMILIES`] through the font
+/// database. None on the web.
+fn system_hangul_face() -> Option<&'static SystemFace> {
+    static FACE: std::sync::OnceLock<Option<SystemFace>> = std::sync::OnceLock::new();
+    FACE.get_or_init(|| {
+        let face = find_system_hangul_face();
+        match &face {
+            Some(f) => log::info!("Korean interface: Hangul from the installed {} (face {})", f.family, f.index),
+            None => log::warn!("Korean interface: no installed Hangul face among {HANGUL_UI_FAMILIES:?}; Hangul shows as boxes"),
+        }
+        face
+    })
+    .as_ref()
+}
+
+#[cfg(target_arch = "wasm32")]
+fn find_system_hangul_face() -> Option<SystemFace> {
+    None
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn find_system_hangul_face() -> Option<SystemFace> {
+    /// Larger files aren't read (the Pan-CJK collections are about 30 MB).
+    const MAX_FILE: u64 = 64 << 20;
+    let has_hangul = |data: &[u8], index: u32| designcraft_fonts::missing_chars(data, index, HANGUL_PROBE).is_empty();
+    for dir in designcraft_fonts::system_font_dirs() {
+        for (file, index, family) in HANGUL_UI_FILES {
+            let path = dir.join(file);
+            if path.metadata().is_ok_and(|m| m.is_file() && m.len() <= MAX_FILE)
+                && let Ok(data) = std::fs::read(&path)
+                && has_hangul(&data, *index)
+            {
+                return Some(SystemFace { family: (*family).to_owned(), index: *index, data: SystemData::File(data) });
+            }
+        }
+    }
+    let db = designcraft_fonts::FontDb::global();
+    for family in HANGUL_UI_FAMILIES {
+        if !db.has_family(family) {
+            continue;
+        }
+        // `face` falls back to another family when this one won't load.
+        let face = db.face(family, "Regular");
+        if face.family.eq_ignore_ascii_case(family) && has_hangul(face.data(), face.index()) {
+            return Some(SystemFace { family: face.family.clone(), index: face.index(), data: SystemData::Db(face) });
+        }
+    }
+    None
+}
